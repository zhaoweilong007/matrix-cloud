{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "workarounds:all"],
  "enabledManagers": ["gradle", "gradle-wrapper", "github-actions"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "Spring Boot",
      "matchPackageNames": ["org.springframework.boot:*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Spring Cloud Alibaba",
      "matchPackageNames": ["com.alibaba.cloud:*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Spring Cloud",
      "matchPackageNames": ["org.springframework.cloud:*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Mica",
      "matchPackageNames": ["net.dreamlu:*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "major dependency updates",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["major"],
      "separateMajorMinor": true
    }
  ]
}
