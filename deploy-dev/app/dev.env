#构建的应用版本号 此版本会作为版本控制使用 由构建时动态指定
VERSION=4.0.0
#时区
TZ=Asia/Shanghai
#=================nacos配置=================
NACOS_SERVER_ADDRESS=192.168.31.20:8848
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_PASSWD=nacos
NACOS_USERNAME=nacos
#===============skywalking配置===================
SW_AGENT_COLLECTOR_BACKEND_SERVICES=127.0.0.1:11800
#===============skywalking注册实例名称，以ip命名========
SW_AGENT_INSTANCE_NAME=127.0.0.1
#==============日志路径配置===================
APP_LOG_PATH=/app/logs
#============JVM参数配置（适配256m容器限制）===========================
JAVA_TOOL_OPTIONS='
-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5000
-Dspring.profiles.active=dev
-Dspring.cloud.nacos.discovery.ip=192.168.31.32
-Xms128m
-Xmx128m
-Xss256k
-XX:MetaspaceSize=64m
-XX:MaxMetaspaceSize=128m
-XX:MaxDirectMemorySize=32m
-XX:+UseStringDeduplication
-XX:+UseCompressedOops
-XX:+OptimizeStringConcat
-XX:+DisableExplicitGC
-XX:+ExitOnOutOfMemoryError
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/app/logs/oom
-XX:+UseG1GC
-XX:MaxGCPauseMillis=100
-XX:+ParallelRefProcEnabled
'
# JVM参数说明（适配256m容器）：
# -Xms128m -Xmx128m：堆内存128m，留余量给非堆和系统
# -Xss256k：线程栈256k，降低内存占用
# -XX:MetaspaceSize=64m -XX:MaxMetaspaceSize=128m：元空间限制
# -XX:MaxDirectMemorySize=32m：直接内存限制
# -XX:+UseG1GC：使用G1垃圾收集器，适合小内存
# -XX:MaxGCPauseMillis=100：GC停顿目标100ms
